# Auto-detect nerdctl when docker is not installed (e.g. after `just prep machine`)
docker := env("DOCKER_ALIAS", if `command -v docker >/dev/null 2>&1 && echo found || echo missing` == "found" { "docker" } else { "nerdctl" })

# List available commands
[private]
default:
  just --justfile {{justfile()}} --list test

# Test backend
[no-cd]
backend:
    {{docker}} compose -f compose.test.yaml build backend
    # Must run separately to avoid exit 0 from s3-init
    {{docker}} compose -f compose.test.yaml run --rm s3-init
    {{docker}} compose -f compose.test.yaml up --detach --wait backend arq-worker \
        || (echo "--- Backend logs ---"; {{docker}} compose -f compose.test.yaml logs backend --tail=80; exit 1)
    # We run like this to ensure correct cleanup after tests done (or early exit)
    sh -c 'trap "just test backend-cleanup || true" EXIT; {{docker}} compose -f compose.test.yaml exec -T backend pytest'

# Cleanup orphan backend tests
[no-cd]
backend-cleanup:
    {{docker}} compose -f compose.test.yaml down --remove-orphans

# Test flight plans in ArduPilot SITL
[no-cd]
sitl:
    {{docker}} compose -f compose.test.yaml build backend
    {{docker}} compose -f compose.test.yaml up --detach sitl
    # Tests run in the backend test image, which has drone_flightplan and pymavlink
    sh -c 'trap "{{docker}} compose -f compose.test.yaml rm --force --stop sitl >/dev/null 2>&1 || true" EXIT; \
        {{docker}} compose -f compose.test.yaml run --rm --no-deps \
        --entrypoint pytest -e SITL_HOST=sitl -e PYTHONDONTWRITEBYTECODE=1 \
        -v "$PWD/contrib/ardupilot-sitl/tests:/sitl-tests:ro" \
        backend -p no:cacheprovider /sitl-tests'
